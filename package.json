{
  "name": "@the-harness-dev/hrev",
  "version": "0.1.3",
  "description": "AI-powered rules-based code review CLI using LangGraph",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-harness-dev/hrev"
  },
  "bin": {
    "hrev": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src/**/*.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "eslint:typecheck": "npm run build && eslint src/**/*.ts"
  },
  "keywords": [
    "code-review",
    "ai",
    "langgraph",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.4.9",
    "@types/glob": "^8.1.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "glob": "^13.0.6",
    "inquirer": "^13.4.3",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=20"
  }
}
